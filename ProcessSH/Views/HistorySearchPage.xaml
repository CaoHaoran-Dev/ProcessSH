<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProcessSH.Views.HistorySearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProcessSH.Models">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 搜索框 -->
        <AutoSuggestBox x:Name="SearchBox"
                        Grid.Row="0"
                        Margin="12"
                        FontFamily="Consolas"
                        FontSize="14"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown" />

        <!-- 结果列表 -->
        <ListView x:Name="ResultList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="ResultList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryEntry">
                    <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind Command}"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Count}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部提示 -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="↑↓ 选择" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Enter 应用" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Esc 关闭" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>