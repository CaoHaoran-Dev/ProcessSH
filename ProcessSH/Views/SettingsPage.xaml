<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ProcessSH.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ProcessSH.Models">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <ScrollViewer Grid.Column="0"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="0,0,1,0">
            <StackPanel x:Name="NavPanel" Padding="8,12" Spacing="2">
                <!-- 动态生成 -->
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧内容 -->
        <ScrollViewer Grid.Column="1" Padding="24">
            <StackPanel x:Name="ContentPanel" Spacing="20" MaxWidth="560">
                <!-- 动态填充 -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>