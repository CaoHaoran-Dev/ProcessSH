<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ProcessSH.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProcessSH">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 字体 -->
            <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
            <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- 尺寸常量 -->
            <x:Double x:Key="MainWindowWidth">520</x:Double>
            <x:Double x:Key="MainWindowBaseHeight">200</x:Double>
            <x:Double x:Key="MainWindowMaxHeight">500</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>