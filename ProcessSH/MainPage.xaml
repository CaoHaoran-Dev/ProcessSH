<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ProcessSH.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ProcessSH.Models"
    xmlns:views="using:ProcessSH.Views">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 输入行 -->
        <Border Grid.Row="0"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="16,8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          Glyph="&#xE756;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="18"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <AutoSuggestBox x:Name="InputBox"
                                Grid.Column="1"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="16"
                                BorderThickness="0"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                TextMemberPath="Text"
                                TextChanged="InputBox_TextChanged"
                                QuerySubmitted="InputBox_QuerySubmitted"
                                SuggestionChosen="InputBox_SuggestionChosen"
                                KeyDown="InputBox_KeyDown">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Suggestion">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="{x:Bind IconGlyph}"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="14"
                                          VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Text}" FontSize="14" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <Button Grid.Column="2"
                        x:Name="CancelButton"
                        Visibility="Collapsed"
                        Click="CancelButton_Click">
                    <FontIcon Glyph="&#xE71A;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <!-- 选项行：sudo + 状态 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="SudoToggle"
                      Grid.Column="0"
                      Checked="SudoToggle_Changed"
                      Unchecked="SudoToggle_Changed" />

            <ProgressRing Grid.Column="1"
                          x:Name="BusyRing"
                          IsActive="False"
                          Width="16" Height="16"
                          HorizontalAlignment="Right"
                          Margin="0,0,8,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button x:Name="CopyButton"
                        Visibility="Collapsed"
                        Click="CopyButton_Click">
                    <FontIcon Glyph="&#xE8C8;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="14" />
                </Button>
                <Button x:Name="ClearButton"
                        Visibility="Collapsed"
                        Click="ClearButton_Click">
                    <FontIcon Glyph="&#xE711;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 输出 / 提示 -->
        <Grid Grid.Row="2">
            <views:OutputTextView x:Name="OutputView"
                                  Visibility="Collapsed" />

            <TextBlock x:Name="HintBlock"
                       VerticalAlignment="Top"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</Page>